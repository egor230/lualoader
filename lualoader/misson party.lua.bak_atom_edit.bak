п»їrequire("lualoader/mod")

function main()
while true do wait() player = findplayer()-- РїРѕР»СѓС‡РёС‚СЊ РёРіСЂРѕРєР°

 if Star_mission_marker(9, 118.0, -825.9, 10.5) -- СЃРѕР·РґР°С‚СЊ РјР°СЂРєРµСЂ РјРёСЃСЃРёРё РЅР° РєР°СЂС‚Рµ.
 then showtext(" patry", 500,1)-- РІС‹РІРѕРґ РЅР°Р·РІР°РЅРёСЏ РјРёСЃСЃРёРё.
 setcord(player, 118.0, -825.9, 10.5) setangle(player, 54.0) -- СѓСЃС‚Р°РЅРѕРІРёС‚СЊ СѓРіРѕР» РґР»СЏ РїРµРґР°.
 bike = Createcar("MODEL_FREEWAY", 123.8, -810.9, 10.5)
 setangle(bike,  320) -- СѓСЃС‚Р°РЅРѕРІРёС‚СЊ СѓРіРѕР» РґР»СЏ Р±Р°Р№РєР°.
 fade(1,2900) --РїСЂРѕСЃРІРµС‚Р»РµРЅРёСЏ, 600 РІСЂРµРјСЏ.
 blip = createmarker(1,2, 95.4, -1136.2, 10.5) -- СЃРѕР·РґР°С‚СЊ РјР°СЂРєРµСЂ РЅР° РєР°СЂС‚Рµ. РџСЂРёРЅРёРјР°РµС‚ С‚РёРї, СЂР°Р·РјРµСЂ, РєРѕРѕСЂРґРёРЅР°С‚С‹, id РјР°СЂРєРµСЂР°.
 setsizemarker(blip,3)--СѓСЃС‚ СЂР°Р·РјРµСЂ РјР°СЂРєРµСЂР°. РџСЂРёРЅРёРјР°РµС‚ РјР°СЂРєРµСЂ, Р·РЅР°С‡РµРЅРёРµ РµРіРѕ СЂР°Р·РјРµСЂР°
 sp = create_sphere(95.4, -1136.2, 10.5,3.0)-- СЃРѕР·РґР°С‚СЊ СЃС„РµСЂСѓ.
 printmessage("~r~Go get some new threads from Rafael's clothes shop",3000,1)

while true == Getflagmission() do  wait() -- С†РёРєР» РїРѕРєР° СЃС‚Р°С‚СѓСЃ РјРёСЃСЃРёРё РЅРµ РёР·РјРµРЅРёС‚СЃСЏ.
  if ped_in_point_in_radius(player,95.4, -1136.2, 10.5, 2.0,2.0,2.0) and not is_ped_in_car(player) and step == nil
   then ped_frozen(0) fade(0,1100) --Р·Р°С‚РµРЅРµРЅРёРµ, 600 РІСЂРµРјСЏ.
   remove_blip(blip)  remove_sphere(sp)-- СѓРґР°Р»РёС‚СЊ СЃС„РµСЂСѓ.
   set_widescreen(true) wait(3000) set_skin(player, "PLAYER9")
   setcord(player, 95.5, -1135.8, 10.5 ) setangle(player, 42.0 ) -- СѓСЃС‚Р°РЅРѕРІРёС‚СЊ СѓРіРѕР» РґР»СЏ РїРµРґР°.
   fade(1,1100) --РїСЂРѕСЃРІРµС‚Р»РµРЅРёСЏ, 600 РІСЂРµРјСЏ.
   set_camera_position(91.813, -1131.116, 17.251, 0.0, 0.0, 0.0) --СѓСЃС‚ РєР°РјРµСЂСѓ РІ РєРѕРѕСЂРґРёРЅР°С‚Р°С….
   camera_at_point(92.39, -1131.74, 16.724, 1) --РїРµСЂРµРјРµСЃС‚РёС‚СЊ РєР°РјРµСЂСѓ РІ РєРѕРѕСЂРґРёРЅР°С‚Р°С….
   wait(3000) ped_frozen(1) restore_camera()-- РІРѕСЃСЃС‚Р°РЅРѕРІРёС‚СЊ РєР°РјРµСЂСѓ.
   set_widescreen(false)   printmessage("~r~Get to then Colonel's boat",3000,1)
   blip1 = createmarker(1,2, -251.2, -1360.8, 8.1 ) -- СЃРѕР·РґР°С‚СЊ РјР°СЂРєРµСЂ РЅР° РєР°СЂС‚Рµ. РџСЂРёРЅРёРјР°РµС‚ С‚РёРї, СЂР°Р·РјРµСЂ, РєРѕРѕСЂРґРёРЅР°С‚С‹, id РјР°СЂРєРµСЂР°.
   setsizemarker(blip1,3)--СѓСЃС‚ СЂР°Р·РјРµСЂ РјР°СЂРєРµСЂР°. РџСЂРёРЅРёРјР°РµС‚ РјР°СЂРєРµСЂ, Р·РЅР°С‡РµРЅРёРµ РµРіРѕ СЂР°Р·РјРµСЂР°
   sp1 = create_sphere(-251.2, -1360.8, 8.1 ,3.0,3.0,2.0)-- СЃРѕР·РґР°С‚СЊ СЃС„РµСЂСѓ.
   load_scene(-236.6, -1374.6, 10.0)
     car1 = Createcar("MODEL_INFERNUS",-242.5, -1349.2, 8.1)
     setangle(car1, 278)
     car2 = Createcar("MODEL_BANSHEE",-243.0, -1345.6, 8.1)
     setangle(car2, 286)
     car3 = Createcar("MODEL_COMET",-244.6, -1340.6, 8.1)
     setangle(car3, 287)
     car4 = Createcar("MODEL_PHEONIX",-245.3, -1336.6, 8.1)
     setangle(car4, 276)
     step = 1
   end
   if step == 1 and ped_in_point_in_radius(player,-251.2, -1360.8, 8.1, 2.0,2.0,2.0) and not is_ped_in_car(player)
   then step = 2 remove_blip(blip1)  remove_sphere(sp1)-- СѓРґР°Р»РёС‚СЊ СЃС„РµСЂСѓ.
   printmessage("~r~You are on the site",3000,1)
   fade(0,1100) -- С‚СЊРјР°, 600 РІСЂРµРјСЏ.
   wait(2000) setcord(player, -241.7, -1362.3, 8.1 )
	setangle(player, 269.0 ) -- СѓСЃС‚Р°РЅРѕРІРёС‚СЊ СѓРіРѕР» РґР»СЏ РїРµРґР°.
	ped1 = create_spec_ped("IGMERC", -241.7, -1360.3, 8.1 )-- СЃРѕР·РґР°С‚СЊ РїРµРґР° РЅР° РєРѕРѕСЂРґРёРЅР°С‚Р°С….
	wait(2000) fade(1,1100) --РїСЂРѕСЃРІРµС‚Р»РµРЅРёСЏ, 600 РІСЂРµРјСЏ.
	printmessage("~r~Take the Colonel's daughter to the Pole Position club", 4000,1)
	blip2 = createmarker(1,2,  100.7, -1477.6, 10.1  ) -- СЃРѕР·РґР°С‚СЊ РјР°СЂРєРµСЂ РЅР° РєР°СЂС‚Рµ. РџСЂРёРЅРёРјР°РµС‚ С‚РёРї, СЂР°Р·РјРµСЂ, РєРѕРѕСЂРґРёРЅР°С‚С‹, id РјР°СЂРєРµСЂР°.
	setsizemarker(blip2,3)--СѓСЃС‚ СЂР°Р·РјРµСЂ РјР°СЂРєРµСЂР°. РџСЂРёРЅРёРјР°РµС‚ РјР°СЂРєРµСЂ, Р·РЅР°С‡РµРЅРёРµ РµРіРѕ СЂР°Р·РјРµСЂР°
	sp2 = create_sphere( 100.7, -1477.6, 10.1, 3.0,3.0,2.0)-- СЃРѕР·РґР°С‚СЊ СЃС„РµСЂСѓ.
	p,m = foel("HFOST", player,"uzi", -179.4, -1442.7, 9.5)-- СЃРѕР·РґР°С‚СЊ РІСЂР°РіР°.
	follow_the_leader(ped1)
	def = true-- РІСЂР°Рі Р¶РёРІ
	ped_save_pos_attack(ped1,1)
	end
 if step == 2
    then
    if def == true -- РµСЃР»Рё РІСЂР°Рі Р¶РёРІ.
      then if getpedhealth(p) == 0
	  then  def = false removemarker(m) --remove_ped(p)
	  end
    end
    if ped_in_point_in_radius(player, 100.7, -1477.6, 10.1, 2.0,2.0,2.0) and ped_in_point_in_radius(ped1, 100.7, -1477.6, 10.1, 2.0,2.0,2.0)
        then remove_blip(blip2) -- СѓРґР°Р»РёС‚СЊ РјРµС‚РєСѓ.
            remove_sphere(sp2)-- СѓРґР°Р»РёС‚СЊ СЃС„РµСЂСѓ.
			clean_leader(ped1)-- РїРµСЂРµСЃС‚Р°С‚СЊ СЃР»РµРґРѕРІР°С‚СЊ Р·Р° Р»РёРґРµСЂРѕРј.
           if is_ped_in_car(ped1)-- РїСЂРѕРІРµСЂРєР° РїРµРґ РІ Р°РІС‚Рѕ?
           then  exitcar(ped1)-- РїРµРґ РІС‹С…РѕРґРёС‚ РёР· Р°РІС‚Рѕ.
	     wait(900) x,y,z = getcoordinates_on_y(ped1, 10)
		 ped_walk_to_point(ped1,x,y,z) wait(6000)
         remove_ped(ped1) miss(1000)-- РјРёСЃСЃРёСЏ РІС‹РїРѕР»РЅРµРЅР° СЃРєРѕР»СЊРєРѕ РґРµРЅРµРі РїРѕР»СѓС‡РµРЅРѕ Р·Р° РІС‹РїРѕР»РЅРµРЅРёРµ.
    step = nil
     break
   end
   end
   if getpedhealth(ped1) == 0 -- РµСЃР»Рё РјРµСЂРґРµСЃ РјРµСЂС‚РІР°, РјРёСЃСЃРёСЏ РїСЂРѕРІР°Р»РµРЅР°.
    then printmessage("mesgess dead", 3000,1) end_mission("mission failed!")
     step = nil-- С€Р°РіРё РѕР±РЅСѓР»СЏСЋС‚СЃСЏ.
     break
    end
   end
 end
 end
 end
 end





