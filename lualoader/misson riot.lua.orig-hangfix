require("lualoader/mod")

-- ============================================================================
-- МИССИЯ "Riot" ("Мятеж") — перенос ОРИГИНАЛА (97 миссий, поток LAWYER4).
--
-- ПОТОК ОРИГИНАЛА:
-- 1. Миссия начинается у ОФИСА КЕНА (118.0, -825.9, 10.5). Значок ставит
--    штатная обёртка Star_mission_marker (C++ блайп, пересоздаётся
--    для повтора автоматически): с 19.09.2026 метка дальнобойная
--    (ADD_SPRITE_BLIP_FOR_CONTACT_POINT 0x2A7) — видна на карте издалека.
-- 2. SET_PLAYER_MOOD 1 60000, REQUEST_ANIMATION 'RIOT'. Два блайпа (оба
--    дальнобойные — видны с любого расстояния):
--    магазин Рафаэля — СПРАЙТ-БЛАЙП значка одежды 28 (02A8
--    ADD_SPRITE_BLIP_FOR_COORD ... 28 $59);
--    стройплощадка — ЖЁЛТЫЙ квадрат (018A ADD_BLIP_FOR_COORD 299 -314.6 11.4
--    $19 даёт цвет 5, затем 016B CHANGE_BLIP_COLOUR 4 = жёлтый). Сфер
--    не заливать: сфера только У ОДЕЖДЫ радиусом 3.
-- 3. Переодевание у Рафаэля (GOSUB L48df8 — КАТСЦЕНА): пешком у двери →
--    01B4 SET_PLAYER_CONTROL 0 + 02A3 SWITCH_WIDESCREEN 1 + 015F/0160 камера →
--    0211 GOTO_COORD_ON_FOOT → 016A DO_FADE 1000 0 (ЗАТЕМНЕНИЕ) → 0352 UNDRESS
--    'PLAYER3' + 038B LOAD_ALL_MODELS_NOW + 0353 DRESS → 0055 SET_PLAYER_
--    COORDINATES 94.9 -1135 9.4 + 0171 SET_PLAYER_HEADING 57.9 → 016A DO_FADE
--    1500 1 (проявление) → 03C8/02EB камера обратно + 01B4 CONTROL 1. Блайп снят.
-- 4. Подъезд к стройке (LOCATE_PLAYER_ANY_MEANS_3D 70/70/30) → сцена бунта:
--    21 пикетчик (SPANDXA/SPANDXB), 3 GDA, 3 грузовика SPAND, 2 объекта -114.
--    Один раз печатается LAW4_13 "Уничтожь грузовики".
-- 5. БОЙ (L4725d): здоровье ≤99 → в бой; умер → intensity -6; укушено>3 или
--    убито>2 → вся толпа (GOSUB L48970), $2205=1. ЛЮБОЙ урон → сразу.
-- 6. ЭСКАЛАЦИЯ: разветвление по ОДЕЖДЕ. БЕЗ одежды — все бьют игрока
--    (kill_player_on_foot). В одежде — дерутся друг с другом (threat 16 без
--    угрозы игроку). В ЛЮБОМ СЛУЧАЕ ОТКРЫВАЮТСЯ ВОРОТА $-33
--    SLIDE_OBJECT 298,-313.6,11 → 304,-313.6,11 (ворота стройки), GDA-боссы
--    получают personality 30 + threat_search, LAW4_14 ($2206=1).
--    Ворота ищутся по координатам (get_obj_in_cord) — модель -33 встречается
--    по всей карте, find_object_by_model вернёт первый попавшийся!
-- 7. Победа — 3 грузовика уничтожены → miss(1000). Провал — M_FAIL ($1778
--    SET_OBJECT_COORDINATES обратно 298,-313.6,11 = закрыть ворота).
--
-- ВАЖНО ПРО АРХИТЕКТУРУ (9-я ревизия): вспомогательные функции живут ВЫШЕ main()
-- (dressed_as_worker, spawn_trucks, start_riot) — состояние миссии передаётся в
-- них параметрами. «Переоделся ли Томми» определяется НЕ флагом, а реальным скином
-- через C++ get_player_skin (CModelInfo) — см. dressed_as_worker ниже.
-- ============================================================================

-- ============================================================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ МИССИИ (вынесены выше main — так читаемее; создаются
-- один раз при загрузке скрипта, а не на каждом старте миссии). Состояние миссии
-- (step, rioters, escalated…) живёт в main и передаётся сюда параметрами — в
-- глобалы не выносить (см. ПЕРЕНОС_МИССИИ_RIOT.md §1).
-- ============================================================================

-- dressed_as_worker(): Томми в одежде рабочего? Определяется по НАСТОЯЩЕМУ скину
-- игрока — C++ get_player_skin (funcs.cpp) читает CModelInfo::GetModelInfo, а НЕ
-- кэш set_skin и не флаг-переменную: переживает перезагрузку скрипта (Ctrl) и
-- учитывает любой путь смены скина, в т.ч. оставшийся с прошлого прохождения.
-- Сравнение в нижнем регистре — движок хранит имена моделей в разном регистре.

-- Функция проверяет, одет ли игрок в рабочего
local function dressed_as_worker()
 local s = get_player_skin() -- Получить скин
 if s == nil then return false end -- Если пусто
 return string.lower(s) == "player3" -- Проверка на рабочий костюм
end

-- Функция размораживает игрока и проявляет экран
local function unfreeze_player()
 ped_frozen(1) -- Разморозить
 fade(1, 1200) -- Проявить экран
 wait(1200) -- Ждать
end

-- Функция создаёт грузовики и возвращает списки авто и маркеров
local function spawn_trucks()
 local trucks, markers = {}, {} -- Инициализация списков
 trucks[1] = Createcar("MODEL_SPAND", 286.7, -302.1, 11.9) if trucks[1] ~= nil then setangle(trucks[1], 270) end -- Создать 1
 trucks[2] = Createcar("MODEL_SPAND", 312.2, -304.7, 11.9) if trucks[2] ~= nil then setangle(trucks[2], 90) end -- Создать 2
 trucks[3] = Createcar("MODEL_SPAND", 312.2, -300.7, 11.9) if trucks[3] ~= nil then setangle(trucks[3], 90) end -- Создать 3
 if trucks[1] ~= nil then markers[1] = create_marker(trucks[1]) end -- Маркер 1
 if trucks[2] ~= nil then markers[2] = create_marker(trucks[2]) end -- Маркер 2
 if trucks[3] ~= nil then markers[3] = create_marker(trucks[3]) end -- Маркер 3
 return trucks, markers -- Вернуть списки
end

-- Функция проверяет уничтожены ли грузовики и снимает маркеры
local function check_trucks_destroyed(trucks, markers)
 local all_dead = true -- Флаг победы
 for i = 1, 3 do -- Цикл по 3 грузовикам
  if trucks[i] ~= nil and isvehicle(trucks[i]) and not iscardead(trucks[i]) and not iscarfire(trucks[i]) then -- Если жив
   all_dead = false -- Не победа
  else -- Иначе мертв
   if markers[i] ~= nil then remove_blip(markers[i]) markers[i] = nil end -- Снять маркер
  end
 end
 return all_dead -- Вернуть статус
end

-- Функция очищает сцену после миссии
local function cleanup_scene(rioters, trucks, agit1, agit2, leader, obj1, obj2)
 for _, r in ipairs(rioters) do if isped(r) then remove_ped(r) end end -- Удалить рабочих
 if agit1 ~= nil and isped(agit1) then remove_ped(agit1) end -- Удалить агитатора 1
 if agit2 ~= nil and isped(agit2) then remove_ped(agit2) end -- Удалить агитатора 2
 if leader ~= nil and isped(leader) then remove_ped(leader) end -- Удалить лидера
 for i=1,3 do if trucks[i] ~= nil and isvehicle(trucks[i]) then remove_car(trucks[i]) end end -- Удалить грузовики
 if obj1 ~= nil then remove_obj(obj1) end -- Удалить объект 1
 if obj2 ~= nil then remove_obj(obj2) end -- Удалить объект 2
end

-- Функция обновляет цели охранников, если их цель умерла
local function update_guard_targets(rioters, guard_target)
 for g, gt in pairs(guard_target) do -- Перебор охранников и их целей
  if isped(g) and not ispeddead(g) then -- Если охранник жив
   if gt == nil or not isped(gt) or ispeddead(gt) then -- Если цель мертва
    local ng = nil -- Новая цель
    for _, r in ipairs(rioters) do -- Поиск живого рабочего
     if isped(r) and not ispeddead(r) then -- Если рабочий жив
      ng = r -- Запомнить
      break -- Прервать поиск
     end
    end
    if ng ~= nil then -- Если найдена новая цель
     set_char_obj_kill_char_on_foot(g, ng) -- Назначить цель
     guard_target[g] = ng -- Сохранить в список
    end
   end
  end
 end
end

-- Функция запускает драку между рабочими или атаку на игрока
local function start_riot(pl, rioters, agit1, agit2, leader, guard_target)
 local guards = {} -- Список охранников
 if agit1 ~= nil then guards[#guards + 1] = agit1 end -- Добавить 1
 if agit2 ~= nil then guards[#guards + 1] = agit2 end -- Добавить 2
 if leader ~= nil then guards[#guards + 1] = leader end -- Добавить лидера

 if not dressed_as_worker() then -- Если без одежды
  for _, r in ipairs(rioters) do -- Перебор рабочих
   if isped(r) then -- Если жив
    clean_ped_wait(r) -- Снять ожидание
    set_ped_personality(r, 30) -- Агрессор
    ped_search_threat(r, 16) -- Ищет горожан
    ped_search_threat(r, 1) -- Ищет игрока
    set_char_obj_kill_player_on_foot(r, pl) -- Атаковать игрока
   end
  end
  for _, g in ipairs(guards) do -- Перебор охранников
   if isped(g) then -- Если жив
    set_ped_personality(g, 30) -- Агрессор
    ped_search_threat(g, 1) -- Ищет игрока
    if g == leader then set_ped_accuracy(leader, 10) end -- Точность лидеру
    set_char_obj_kill_player_on_foot(g, pl) -- Атаковать игрока
   end
  end
  printmessage("~r~They've seen you! Get out!", 4000, 1) -- Сообщение
 else -- Если в одежде
  local n = #rioters -- Кол-во рабочих
  for i, r in ipairs(rioters) do -- Перебор рабочих
   if isped(r) then -- Если жив
    clean_ped_wait(r) -- Снять ожидание
    set_ped_only_damaged_by_player(r, false) -- Разрешить урон от всех
    set_ped_personality(r, 30) -- Агрессор
    ped_search_threat(r, 16) -- Ищет горожан
    local t = rioters[(i % n) + 1] -- Выбор соседа
    if t ~= nil and isped(t) and t ~= r then -- Проверка
     set_char_obj_kill_char_on_foot(r, t) -- Атаковать соседа
    end
   end
  end
  for _, g in ipairs(guards) do -- Перебор охранников
   if isped(g) then -- Если жив
    set_ped_stay_when_attacked(g, false) -- Не стоять на месте
    set_ped_personality(g, 30) -- Агрессор
    ped_search_threat(g, 16) -- Ищет горожан
    if g == leader then set_ped_accuracy(leader, 10) end -- Точность лидеру
    local gt = nil -- Цель
    for _, r in ipairs(rioters) do if isped(r) and not ispeddead(r) then gt = r break end end -- Поиск цели
    if gt ~= nil then -- Если найден
     set_char_obj_kill_char_on_foot(g, gt) -- Атаковать
     guard_target[g] = gt -- Сохранить
    end
   end
  end
  printmessage("~r~The workers have turned on each other! Get the trucks!", 4000, 1) -- Сообщение
 end
end

-- Функция создаёт выпадение оружия из трупа
local function drop_agitator_colt(agit, dropped)
 if dropped == 0 and agit ~= nil and isped(agit) and ispeddead(agit) then -- Если мертв и не выпадал
  local dx, dy, dz = get_dead_char_pickup_coords(agit) -- Координаты трупа
  if dx ~= nil then -- Если есть
   create_weapon_pickup(274, 3, 17, dx, dy, dz + 0.5) -- Создать колт
   return 1 -- Вернуть флаг
  end
 end
 return dropped -- Вернуть старый флаг
end

-- Функция запускает катсцену переодевания
local function dress_cutscene(pp, dress_blip, dress_sphere)
 ped_frozen(0) -- Заморозить
 set_widescreen(true) -- Широкий экран
 set_camera_position(91.813, -1131.12, 17.251, 0.0, 0.0, 0.0) -- Позиция камеры
 camera_at_point(92.39, -1131.74, 16.724, 2) -- Направление камеры
 set_char_obj_goto_coord_on_foot(pp, 96.4, -1136.7, 9.4) -- Идти к двери
 wait(1300) -- Ждать
 fade(0, 1000) -- Затемнение
 wait(1000) -- Ждать
 set_skin(pp, "PLAYER3") -- Переодевание
 setcord(pp, 94.9, -1135.0, 9.4) -- Телепорт
 setangle(pp, 57.9) -- Угол
 fade(1, 1500) -- Проявление
 wait(1500) -- Ждать
 restore_camera() -- Сброс камеры
 ped_frozen(1) -- Разморозить
 set_widescreen(false) -- Выкл широкий экран
 if dress_blip ~= nil then remove_blip(dress_blip) dress_blip = nil end -- Удалить блайп
 if dress_sphere ~= nil then remove_sphere(dress_sphere) dress_sphere = nil end -- Удалить сферу
 printmessage("~g~You look like a worker. ~y~Now hit the construction site!", 5000, 1) -- Сообщение
 return dress_blip, dress_sphere -- Вернуть
end

-- Функция создаёт толпу и возвращает списки состояния
local function spawn_rioters()
 local rioters, bite_flag, dead_flag, hp_prev = {}, {}, {}, {} -- Списки
 local coords = { -- Координаты
  {304.7,-316.8},{302.8,-318.8},{301.6,-316.7},{299.8,-318.2},
  {300.9,-321.6},{299.0,-322.1},{295.0,-320.7},{293.5,-317.8},
  {296.2,-325.3},{299.3,-329.3},{303.8,-329.7},{308.5,-328.4},
  {310.2,-324.2},{305.6,-322.2},{300.0,-317.5},{294.9,-317.6},
  {291.0,-320.0},{293.0,-324.8},{291.6,-317.2},{301.1,-324.0},
  {297.6,-327.649}
 }
 for i, p in ipairs(coords) do -- Цикл по координатам
  local skin = (i % 2 == 1) and "SPANDXA" or "SPANDXB" -- Чередование скинов
  local r = Createped(skin, p[1], p[2], 10.9) -- Создать педа
  if r ~= nil then -- Если создан
   ped_clean_threat(r) -- Сброс угроз
   set_ped_personality(r, 16) -- Личность горожанина
   set_ped_only_damaged_by_player(r, true) -- Урон только от игрока
   set_ped_wait_state(r, 29, 99999999) -- Ожидание
   table.insert(rioters, r) -- Добавить в список
   bite_flag[#rioters] = 0 -- Флаг укуса
   dead_flag[#rioters] = 0 -- Флаг смерти
   hp_prev[#rioters] = getpedhealthf(r) -- Здоровье
  end
 end
 return rioters, bite_flag, dead_flag, hp_prev -- Вернуть списки
end

-- Функция создаёт всю сцену бунта
local function spawn_riot_scene(player, riot_intensity)
 Giveweaponped(player, 6, "molotov") -- Выдать молотов
 set_current_weapon_ped(player, 15) -- В руки
 set_riot_intensity(riot_intensity) -- Интенсивность

 local trucks, markers = spawn_trucks() -- Грузовики
 local obj1 = create_obj(-114, 309.3, -298.6, 10.9) if obj1 ~= nil then make_obj_targettable(obj1, true) end -- Объект 1
 local obj2 = create_obj(-114, 284.3, -312.4, 10.9) if obj2 ~= nil then make_obj_targettable(obj2, true) end -- Объект 2
 local gate = get_obj_in_cord(298.0, -313.6, 11.0, 8.0) -- Ворота

 local rioters, bite_flag, dead_flag, hp_prev = spawn_rioters() -- Толпа

 local agit1 = Createped("GDA", 301.2, -311.5, 10.9) if agit1 ~= nil then setangle(agit1, 180) end -- Агитатор 1
 local agit2 = Createped("GDA", 303.2, -311.5, 10.9) if agit2 ~= nil then setangle(agit2, 180) end -- Агитатор 2
 local leader = Createped("GDA", 304.0, -298.7, 10.9) if leader ~= nil then setangle(leader, 180) end -- Лидер

 if agit1 ~= nil then Giveweaponped(agit1, 0, "nitestick") set_current_weapon_ped(agit1, 4) set_ped_only_damaged_by_player(agit1, true) end -- Оружие 1
 if agit2 ~= nil then Giveweaponped(agit2, 0, "nitestick") set_current_weapon_ped(agit2, 4) set_ped_only_damaged_by_player(agit2, true) end -- Оружие 2
 if leader ~= nil then -- Лидер
  sethealth(leader, 70) -- Здоровье
  Giveweaponped(leader, 300, "colt45") -- Оружие
  set_current_weapon_ped(leader, 17) -- В руки
  set_ped_stay_when_attacked(leader, true) -- Держать позицию
  set_ped_only_damaged_by_player(leader, true) -- Урон от игрока
 end

 return rioters, bite_flag, dead_flag, hp_prev, trucks, markers, obj1, obj2, gate, agit1, agit2, leader -- Вернуть
end

-- Функция проверки: все ли рабочие погибли
local function check_workers_dead(rioters)
 for _, r in ipairs(rioters) do -- Перебор
  if isped(r) and not ispeddead(r) then -- Если жив
   return false -- Не провал
  end
 end
 return true -- Провал
end

function main()
 while true do wait() -- Внешний цикл
  local player = findplayer() -- Игрок

  if Star_mission_marker(9, 118.0, -825.9, 10.5) then -- Если старт
   unfreeze_player() -- Разморозить и экран

   local step = 1 -- Этап
   local bitten, killed, escalated = 0, 0, 0 -- Счетчики
   local riot_intensity, gates_open, gate_frames = 127, 0, 0 -- Параметры
   local law4_13_shown, frame, agit1_drop, agit2_drop = 0, 0, 0, 0 -- Флаги

   local rioters, bite_flag, dead_flag, hp_prev -- Списки
   local trucks, markers -- Списки
   local obj1, obj2, gate, agit1, agit2, leader -- Объекты
   local guard_target = {} -- Цели охраны

   set_wanted(0) -- Сброс розыска
   showtext(" Riot", 500, 1) -- Заголовок
   printmessage("~w~Ken: Tommy! The workers at Avery's site have gone on the rampage!", 5000, 1) -- Текст
   wait(2000) -- Ждать
   printmessage("~w~Ken: Get some work clothes from Rafael's so they don't recognize you!", 6000, 1) -- Текст
   wait(2000) -- Ждать

   set_ped_mood(1, 60000) -- Настроение
   request_animation("RIOT") -- Анимация

   local dress_blip = radar_add_sprite_blip_for_coord(95.4, -1135.5, 9.4, 28) -- Блайп одежды
   local dress_sphere = create_sphere(95.4, -1135.5, 9.4, 3.0) -- Сфера одежды
   local site_blip = radar_add_blip_for_coord(299.0, -314.6, 11.4) -- Блайп стройки
   if site_blip ~= nil then radar_change_blip_colour(site_blip, 4) end -- Цвет блайпа

   printmessage("~g~Get the work outfit at Rafael's, then hit the construction site.", 6000, 1) -- Текст

   while true == Getflagmission() do wait() -- Основной цикл
    local pp = findplayer() -- Игрок
    if pp == nil then pp = player end -- Запасной

    if (step == 1 or step == 3) and not dressed_as_worker() and not is_ped_in_car(pp) -- Условие
    and ped_in_point_in_radius(pp, 95.4, -1135.5, 9.4, 1.2, 1.2, 3.0) then -- Радиус
     dress_blip, dress_sphere = dress_cutscene(pp, dress_blip, dress_sphere) -- Запуск катсцены
    end

    if step == 1 and ped_in_point_in_radius(pp, 299.0, -314.6, 11.4, 70.0, 70.0, 30.0) then -- Подъезд
     if site_blip ~= nil then remove_blip(site_blip) site_blip = nil end -- Снять блайп
     if dressed_as_worker() then -- Если одет
      if dress_blip ~= nil then remove_blip(dress_blip) dress_blip = nil end -- Снять блайп
      if dress_sphere ~= nil then remove_sphere(dress_sphere) dress_sphere = nil end -- Снять сферу
     end

     rioters, bite_flag, dead_flag, hp_prev, trucks, markers, obj1, obj2, gate, agit1, agit2, leader = spawn_riot_scene(player, riot_intensity) -- Создать сцену

     printmessage("~g~Destroy the workers' trucks to break the strike!", 6000, 1) -- Текст
     printmessage("~r~Workers: This is our site! Get out!", 5000, 1) -- Текст
     printmessage("~r~Workers: Burn everything! Strike forever!", 5000, 1) -- Текст
     step = 3 -- Переход на бой
    end

    if step == 3 and law4_13_shown == 0 and ped_in_point_in_radius(pp, 299.0, -314.6, 11.4, 20.0, 20.0, 10.0) then -- Близко
     law4_13_shown = 1 -- Флаг
     printmessage("~r~Destroy the trucks! Now!", 8000, 1) -- Текст
    end

    if step == 3 then -- Бой
     frame = frame + 1 -- Кадр
     if frame % 120 == 0 then ma_trace("riot: бой frame=" .. frame .. " bitten=" .. bitten .. " killed=" .. killed) end -- Трейс
     if frame % 60 == 0 then Giveweaponped(pp, 6, "molotov") end -- Держать запас молотова (нельзя остаться без оружия)

     for i, r in ipairs(rioters) do -- Перебор рабочих
      if isped(r) then -- Если жив
       if not ispeddead(r) then -- Если не мертв
        local h = getpedhealthf(r) -- Здоровье
        if bite_flag[i] == 0 and escalated == 0 and h < hp_prev[i] then -- Упало HP
         bite_flag[i] = 1 -- Укушен
         bitten = bitten + 1 -- Счетчик
        end
        hp_prev[i] = h -- Сохранить
       else -- Если мертв
        if dead_flag[i] == 0 then -- Не учтен
         dead_flag[i] = 1 -- Мертв
         killed = killed + 1 -- Счетчик
         riot_intensity = riot_intensity - 6 -- Убавить бунт
         if riot_intensity < 0 then riot_intensity = 0 end -- Лимит
         set_riot_intensity(riot_intensity) -- Применить
        end
       end
      end
     end

     if escalated == 0 and (bitten > 0 or killed > 0) then -- Эскалация
      start_riot(pp, rioters, agit1, agit2, leader, guard_target) -- Начать бунт
      escalated = 1 -- Флаг
     end

     if escalated == 1 and gates_open == 0 then -- Открытие ворот
      gates_open = 1 -- Флаг
      gate_frames = 60 -- Кадры
      printmessage("~r~Lawyers and cops are on their way! Get the trucks!", 8000, 1) -- Текст
     end

     if escalated == 1 and dressed_as_worker() then -- Перебинд целей
      update_guard_targets(rioters, guard_target) -- Вызов функции
     end

     if gates_open == 1 and gate ~= nil and gate_frames > 0 then -- Движение ворот
      move_obj(gate, 304.0, -313.6, 11.0, 0.1, 0.1, 0.0, 0) -- Двигать
      gate_frames = gate_frames - 1 -- Убавить
     end

     if killed > 14 then set_riot_intensity(0) end -- Слишком много убито

     agit1_drop = drop_agitator_colt(agit1, agit1_drop) -- Выпадение 1
     agit2_drop = drop_agitator_colt(agit2, agit2_drop) -- Выпадение 2

     if pp ~= nil and (ispeddead(pp) or getpedhealthf(pp) <= 0) then -- Игрок умер
      printmessage("~r~Tommy was killed! Mission failed!", 4000, 1) -- Текст провала
      end_mission("mission failed!") -- Провал
      step = nil -- Конец
      break -- Выход
     end

     if check_workers_dead(rioters) then -- Если все рабочие мертвы
      printmessage("~r~All workers are dead! Mission failed!", 4000, 1) -- Текст провала
      end_mission("mission failed!") -- Провал
      step = nil -- Конец
      break -- Выход
     end

     if check_trucks_destroyed(trucks, markers) then -- Если грузовики уничтожены
      remove_animation("RIOT") -- Выгрузить аним
      set_riot_intensity(0) -- Выключить бунт
      printmessage("~g~The strike is broken! Avery's site is secure.", 4000, 1) -- Текст победы
      wait(4000) -- Ждать
      cleanup_scene(rioters, trucks, agit1, agit2, leader, obj1, obj2) -- Очистка сцены
      miss(1000) -- Победа
      step = nil -- Конец
      break -- Выход
     end
    end
   end
  end
 end
end
